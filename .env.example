# BRIX runtime configuration.
# Copy to a local environment file and provide the correct project for that environment.
# Never point local development or preview builds at production by accident.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side Supabase edge function secrets.
# Do not prefix these with VITE_. They must stay server-side.
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_CONTRACT_MODEL=gpt-4o
FRED_API_KEY=
BLS_API_KEY=
CENSUS_API_KEY=

# Stripe billing. Keep secret values server-side only.
VITE_STRIPE_PRODUCT_ID=
VITE_STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BRIX_MONTHLY_PRICE_CENTS=15599
